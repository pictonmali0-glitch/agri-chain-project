# AgriChain Backend – Environment Variables
# Copy this file to .env and fill in your values

# ── Security ───────────────────────────────────────────────────
SECRET_KEY=agrichain-change-this-in-production-2024
JWT_SECRET_KEY=agrichain-jwt-change-this-in-production-2024

# ── Database ───────────────────────────────────────────────────
# SQLite (default, good for development):
DATABASE_URL=sqlite:///agrichain.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/agrichain

# ── Email (SMTP) ────────────────────────────────────────────────
# Gmail setup:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to myaccount.google.com → Security → App passwords
# 3. Create an app password for "Mail" → "Other (Custom name)" → AgriChain
# 4. Use that 16-character app password below (no spaces)

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=AgriChain <noreply@agrichain.app>

# Alternative: Mailgun
# MAIL_SERVER=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@your-domain.mailgun.org
# MAIL_PASSWORD=your-mailgun-smtp-password

# ── Upload settings ─────────────────────────────────────────────
MAX_CONTENT_LENGTH=16777216   # 16MB in bytes

# ── Development flags ───────────────────────────────────────────
# In development, OTP codes are printed to console if email fails
# Set FLASK_DEBUG=0 in production
FLASK_DEBUG=1
